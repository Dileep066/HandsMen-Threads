                <rightValue>
                    <numberValue>500.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Loyalty_Status_to_Bronze</targetReference>
            </connector>
            <label>Bronze</label>
        </rules>
    </decisions>
