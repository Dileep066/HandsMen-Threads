        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Loyalty_Status_to_Silver</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Silver</defaultConnectorLabel>
        <rules>
            <name>Gold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Collection_Variable.Total_Purchases__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Loyalty_Status_to_Gold</targetReference>
            </connector>
            <label>Gold</label>
        </rules>
        <rules>
            <name>Bronze</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Collection_Variable.Total_Purchases__c</leftValueReference>
